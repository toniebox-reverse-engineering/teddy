<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 so the (still Windows-only) TeddyBench net48 GUI keeps building until it is ported. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <NoWarn>1701;1702;168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Concentus.Oggfile\Concentus.Oggfile.csproj" />
    <ProjectReference Include="..\Concentus\Concentus.csproj" />
    <ProjectReference Include="..\ID3\ID3.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- NAudio.Core only: the full NAudio package pulls in WinMM/MediaFoundation/WinForms (Windows only). -->
    <PackageReference Include="NAudio.Core" Version="2.0.0" />
    <!-- Fully managed MP3 decoder, replaces the Windows ACM decoder behind NAudio's Mp3FileReader. -->
    <PackageReference Include="NLayer.NAudioSupport" Version="1.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
</Project>
