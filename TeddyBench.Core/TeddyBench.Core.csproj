<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- UI-independent TeddyBench logic. netstandard2.0 so both the net48 WinForms GUI and a future
         cross-platform (Avalonia, net10.0) GUI can use it. Must not reference WinForms/System.Drawing. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TeddyBench.Core</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <NoWarn>1701;1702;168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TonieAudio\TonieAudio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ELFSharp" Version="2.13.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="System.IO.Ports" Version="6.0.0" />
  </ItemGroup>
</Project>
